# Ninguna variable es obligatoria. Copiá este archivo a .env.local para usarlas.

# URL pública del sitio (sin barra final). Se lee al compilar. Se usa para canonical, og:url, og:image absolutos, /sitemap.xml y la línea Sitemap de /robots.txt.
VITE_SITE_URL=

# Ruta a un Chromium para las pruebas E2E (npm run test:e2e), si Playwright no encuentra el suyo.
# CHROMIUM_PATH=/ruta/a/chromium
