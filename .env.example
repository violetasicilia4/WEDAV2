# Ninguna variable es obligatoria. Copiá este archivo a .env.local para usarlas.

# URL pública del sitio (sin barra final). Se lee al compilar. Se usa para canonical, og:url, og:image absolutos, /sitemap.xml y la línea Sitemap de /robots.txt.
VITE_SITE_URL=

# Ruta a un Chromium para las pruebas E2E (npm run test:e2e), si Playwright no encuentra el suyo.
# CHROMIUM_PATH=/ruta/a/chromium

# --- Servidor (nunca se publican al navegador). Ver docs/backend-readiness.md §9 ---
# Archivo SQLite de la base. En producción: un volumen persistente (SQLite no sirve en hosting efímero/serverless).
# WEDA_DB_PATH=.data/weda.db
# Carpeta privada de comprobantes.
# WEDA_DATA_DIR=.data
# Cookie con atributo Secure (por defecto true si NODE_ENV=production; requiere HTTPS).
# WEDA_COOKIE_SECURE=true
# Publicar exige una orden de compra pagada. Mantener en false hasta tener proveedor de pagos y reglas comerciales aprobadas.
# WEDA_REQUIRE_PAID_ORDER=false
# Orígenes extra permitidos para escrituras (separados por coma). Vacío = solo el propio host.
# WEDA_ALLOWED_ORIGINS=
