# Ninguna variable es obligatoria. Copiá este archivo a .env.local para usarlas.

# URL pública del sitio (sin barra final). Se lee al compilar. Se usa para canonical, og:url, og:image absolutos, /sitemap.xml y la línea Sitemap de /robots.txt.
VITE_SITE_URL=

# Ruta a un Chromium para las pruebas E2E (npm run test:e2e), si Playwright no encuentra el suyo.
# CHROMIUM_PATH=/ruta/a/chromium

# --- Servidor (nunca se publican al navegador). Ver docs/backend-readiness.md §9 ---
# Archivo SQLite de la base. En producción: un volumen persistente (SQLite no sirve en hosting efímero/serverless).
# WEDA_DB_PATH=.data/weda.db
# Carpeta privada de comprobantes.
# WEDA_DATA_DIR=.data
# Cookie con atributo Secure (por defecto true si NODE_ENV=production; requiere HTTPS).
# WEDA_COOKIE_SECURE=true
# Publicar exige una orden de compra pagada. Mantener en false hasta tener proveedor de pagos y reglas comerciales aprobadas.
# WEDA_REQUIRE_PAID_ORDER=false
# Orígenes extra permitidos para escrituras (separados por coma). Vacío = solo el propio host.
# WEDA_ALLOWED_ORIGINS=

# Clave de navegador de Google Maps (Maps JavaScript API + Places API (New)) para el buscador de lugares de los eventos.
# Restringila por dominio (referrer HTTP) en la consola de Google Cloud. Vacía = el editor muestra los campos de dirección de siempre.
VITE_GOOGLE_MAPS_KEY=

# --- Correo saliente (servidor). Ver docs/datos-personales.md ---
# Clave de Resend (resend.com). Vacía = no se envía ningún correo: cada intento queda registrado en mail_log como «skipped».
# RESEND_API_KEY=
# Remitente (el dominio tiene que estar verificado en Resend: registros SPF/DKIM en el DNS de weda.app).
# WEDA_MAIL_FROM=Weda <hola@weda.app>
# WEDA_MAIL_REPLY_TO=hola@weda.app
# Dirección pública del sitio, para los enlaces de los correos (adjuntar comprobante, darse de baja).
# WEDA_PUBLIC_URL=https://weda.app
# Secreto para firmar los enlaces de baja. OBLIGATORIO en producción: 32+ caracteres al azar (por ejemplo: openssl rand -base64 48).
# WEDA_SECRET=

# --- Pagos (servidor). Ver docs/auditoria-ux-conversion/payment-integration.md ---
# Proveedor de pagos. Vacío = no se cobra. «test» = proveedor de PRUEBA (página /pago-de-prueba, nunca cobra): SOLO local o staging, JAMÁS producción.
# Con un proveedor configurado, publicar exige un pago confirmado por el servidor. Un proveedor real (Mercado Pago) todavía no está integrado.
# WEDA_PAYMENTS_PROVIDER=
# Secreto para verificar la firma de las notificaciones del proveedor (por defecto, WEDA_SECRET).
# WEDA_PAYMENTS_WEBHOOK_SECRET=

# --- Analítica (navegador). Vacía = apagada: no se manda nada. «on» = eventos del embudo al propio servidor (/api/events), sin datos personales.
# VITE_ANALYTICS=
